library(leaflet)
install.packages("leaflet")
library(leaflet)
leaflet() |>
#addTiles() %>%  # Add default OpenStreetMap map tiles
addMarkers(lng=174.768, lat=-36.852, popup="The birthplace of R")
library(leaflet)
leaflet() |>
addTiles() %>%  # Add default OpenStreetMap map tiles
addMarkers(lng=174.768, lat=-36.852, popup="The birthplace of R")
library(leaflet)
leaflet() |>
addTiles() %>%
addMarkers(lng=6.918, lat=50.929) |>
addPopups(lng=6.918, lat=50.929,
popup="Zentrum für Lehrer*innenbildung (ZfL), Besuchsadresse: Immermannstraße 49, 50931 Köln")
